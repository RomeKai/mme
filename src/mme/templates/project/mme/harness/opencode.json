    "meta": {
      "name": "Meta Model API",
      "npm": "@ai-sdk/openai",
      "options": { "baseURL": "https://api.meta.ai/v1" },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "muse-spark-1.3-contributor",

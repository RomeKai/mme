          "options": { "reasoningEffort": "high", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] }
        },
        "muse-wonder-1.0": {
          "name": "muse-wonder-1.0",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 131072 },
